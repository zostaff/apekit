{
  "name": "apekit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "pump.fun bundler + volume bot. Jito bundles, staggered buys, multi-wallet volume generation.",
  "engines": { "node": ">=22" },
  "scripts": {
    "bundle": "node --no-deprecation --env-file-if-exists=.env bundle.mjs",
    "volume": "node --no-deprecation --env-file-if-exists=.env volume.mjs",
    "sell": "node --no-deprecation --env-file-if-exists=.env sell.mjs",
    "drain": "node --no-deprecation --env-file-if-exists=.env drain.mjs"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "2.0.0",
    "@solana/web3.js": "^1.98.0",
    "@solana/spl-token": "^0.4.15",
    "bn.js": "^5.2.1",
    "bs58": "^4.0.1"
  }
}
